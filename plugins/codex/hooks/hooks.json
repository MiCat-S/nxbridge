{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bridge.cjs\" hook --host codex",
            "timeout": 10,
            "additionalContextLimit": 200000,
            "statusMessage": "nxbridge: session start/registration"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bridge.cjs\" hook --host codex",
            "timeout": 3,
            "statusMessage": "nxbridge: session end/context cleanup"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bridge.cjs\" hook --host codex",
            "timeout": 10,
            "statusMessage": "nxbridge: prompt submit (pair/config confirm, busy state)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "claude",
            "tool": "nxbridge_hook",
            "input": {
              "session_id": "${session_id}",
              "hook_event_name": "${hook_event_name}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}",
              "turn_id": "${turn_id}",
              "model": "${model}",
              "permission_mode": "${permission_mode}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_response": "${tool_response}",
              "tool_use_id": "${tool_use_id}"
            },
            "timeout": 10,
            "statusMessage": "nxbridge: post tool use (pickup/sync)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:collaboration[._]*)?spawn_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bridge.cjs\" hook --host codex",
            "timeout": 10,
            "statusMessage": "nxbridge: spawn_agent nxref expansion"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bridge.cjs\" hook --host codex",
            "timeout": 10,
            "statusMessage": "nxbridge: subagent stop/nxref capture"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bridge.cjs\" hook --host codex",
            "timeout": 10,
            "statusMessage": "nxbridge: permission request/human-needed state"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bridge.cjs\" hook --host codex",
            "timeout": 3,
            "statusMessage": "nxbridge: interrupt/pause and cancel questions"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bridge.cjs\" hook --host codex",
            "timeout": 10,
            "statusMessage": "nxbridge: stop/ready state"
          }
        ]
      }
    ]
  }
}
